# ---------------------------------------------------------------------------
# DevOps Agent Platform - example environment file.
# Copy to `.env` and fill in real values:  copy .env.example .env
# Values below are safe *development* defaults; production deployments MUST
# override every secret (Settings.assert_production_ready() enforces this).
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=DevOps Agent Platform
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devops_agents
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Vector store ---
VECTOR_BACKEND=pgvector          # pgvector | memory   (memory = no pgvector needed, dev/tests)
VECTOR_DIMENSIONS=1536
VECTOR_SIMILARITY_THRESHOLD=0.65

# --- Queue ---
QUEUE_BACKEND=redis              # redis | memory
REDIS_URL=redis://localhost:6379/0
EVENT_QUEUE_NAME=events
PRIORITY_QUEUE_NAME=events-priority

# --- LLM ---
LLM_PROVIDER=openai              # openai | fake   (fake = deterministic offline gateway)
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# --- Auth (SSO / OIDC) ---
OAUTH2_CLIENT_ID=replace-me
OAUTH2_CLIENT_SECRET=replace-me
OAUTH2_AUTHORIZATION_URL=https://sso.example.com/oauth2/authorize
OAUTH2_TOKEN_URL=https://sso.example.com/oauth2/token
OAUTH2_USERINFO_URL=https://sso.example.com/oauth2/userinfo
OAUTH2_REDIRECT_URI=http://localhost:8000/auth/callback
OAUTH2_SCOPES=openid profile email
OAUTH2_ADMIN_EMAILS=[]
JWT_SECRET_KEY=dev-only-insecure-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEFAULT_USER_ROLE=on-call-engineer

# --- Team routing (repo/service -> team name JSON map) ---
DEFAULT_TEAM_NAME=platform
TEAM_ROUTING={"acme/payments-service": "payments", "payments-service": "payments"}

# --- Integrations: GitHub / GitLab ---
GITHUB_WEBHOOK_SECRET=dev-github-webhook-secret
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITLAB_WEBHOOK_SECRET=dev-gitlab-webhook-secret
GITLAB_API_BASE_URL=https://gitlab.com/api/v4
GITLAB_TOKEN=

# --- Integrations: Jenkins ---
JENKINS_BASE_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_WEBHOOK_SECRET=dev-jenkins-webhook-secret

# --- Integrations: Monitoring / Ticketing ---
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_WEBHOOK_SECRET=
PAGERDUTY_INTEGRATION_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=
